# 1. CARGAR LIBRERÍAS


library(readxl)
library(ggplot2)



# 2. LEER LA BASE DE DATOS


datos <- read_excel(
  "Base_Datos.xlsx",
  sheet = "Respuestas de formulario 1"
)

cat("Número de estudiantes:", nrow(datos), "\n")
cat("Número de variables:", ncol(datos), "\n")



# 3. PREPARAR LAS VARIABLES


edad <- datos[[1]]
genero <- datos[[2]]
ciclo <- datos[[3]]
usa_transporte <- datos[[4]]
tipo_transporte <- datos[[5]]
dias_semana <- datos[[6]]
viajes_semana <- datos[[7]]
pasaje <- datos[[8]]
gasto_mensual <- as.numeric(datos[[9]])
caminar <- datos[[10]]
medio_pasaje <- datos[[11]]


# ============================================================
# 4. CREAR DATA FRAME
# ============================================================

df <- data.frame(
  edad = edad,
  genero = genero,
  ciclo = ciclo,
  usa_transporte = usa_transporte,
  tipo_transporte = tipo_transporte,
  dias_semana = dias_semana,
  viajes_semana = viajes_semana,
  pasaje = pasaje,
  gasto_mensual = gasto_mensual,
  caminar = caminar,
  medio_pasaje = medio_pasaje
)

# Eliminar valores faltantes del gasto
gasto <- df$gasto_mensual
gasto <- gasto[!is.na(gasto)]

n <- length(gasto)



# 5. ESTADÍSTICAS DESCRIPTIVAS


calcular_moda <- function(x) {
  ux <- unique(x)
  ux[which.max(tabulate(match(x, ux)))]
}

media_val <- mean(gasto)
mediana_val <- median(gasto)
moda_val <- calcular_moda(gasto)
de_val <- sd(gasto)
varianza_val <- var(gasto)
min_val <- min(gasto)
max_val <- max(gasto)
rango_val <- max_val - min_val
cv_val <- (de_val / media_val) * 100



# 6. MEDIDAS DE FORMA

m <- mean(gasto)
s <- sd(gasto)

# Asimetría
asimetria_val <- (
  n / ((n - 1) * (n - 2))
) * sum(
  ((gasto - m) / s)^3
)

# Curtosis
curtosis_val <- (
  n * (n + 1) /
    ((n - 1) * (n - 2) * (n - 3))
) * sum(
  ((gasto - m) / s)^4
) -
  (3 * (n - 1)^2 /
     ((n - 2) * (n - 3)))



# 7. MOSTRAR ESTADÍSTICAS


cat("\n")
cat("============================================\n")
cat("ESTADÍSTICAS DEL GASTO MENSUAL\n")
cat("============================================\n")

cat("N:", n, "\n")
cat(sprintf("Media: S/ %.2f\n", media_val))
cat(sprintf("Mediana: S/ %.2f\n", mediana_val))
cat(sprintf("Moda: S/ %.2f\n", moda_val))
cat(sprintf("Desviación estándar: S/ %.2f\n", de_val))
cat(sprintf("Varianza: %.2f\n", varianza_val))
cat(sprintf("Mínimo: S/ %.2f\n", min_val))
cat(sprintf("Máximo: S/ %.2f\n", max_val))
cat(sprintf("Rango: S/ %.2f\n", rango_val))
cat(sprintf("CV: %.2f%%\n", cv_val))
cat(sprintf("Asimetría: %.4f\n", asimetria_val))
cat(sprintf("Curtosis: %.4f\n", curtosis_val))


