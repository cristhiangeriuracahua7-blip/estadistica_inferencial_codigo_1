# 8. ESTUDIANTES CON GASTO >= S/100
# ============================================================

estudiantes_100_mas <- sum(gasto >= 100)
total_estudiantes <- length(gasto)
proporcion <- estudiantes_100_mas / total_estudiantes

cat("\n")
