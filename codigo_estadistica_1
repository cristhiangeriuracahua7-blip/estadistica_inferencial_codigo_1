# 15. FIGURA 7
# DISTRIBUCIÓN MUESTRAL DE LA PROPORCIÓN


n_prop <- length(gasto)

x_exitos <- sum(gasto >= 100)

p_hat <- x_exitos / n_prop
q_hat <- 1 - p_hat

error_prop <- sqrt(
  (p_hat * q_hat) / n_prop
)

z_critico <- 1.96

x_prop <- seq(
  p_hat - 4 * error_prop,
  p_hat + 4 * error_prop,
  length.out = 500
)

y_prop <- dnorm(
  x_prop,
  mean = p_hat,
  sd = error_prop
)

datos_prop <- data.frame(
  x = x_prop,
  y = y_prop
)

grafico_prop <- ggplot(
  datos_prop,
  aes(x = x, y = y)
) +
  geom_line(
    color = "darkgreen",
    linewidth = 1.2
  ) +
  geom_vline(
    xintercept = p_hat,
    color = "red",
    linewidth = 1
  ) +
  labs(
    title = "Distribución muestral de la proporción",
    x = "Proporción muestral",
    y = "Densidad"
  ) +
  theme_classic() +
  theme(
    plot.title = element_text(
      face = "bold",
      hjust = 0.5
    )
  )

print(grafico_prop)



# 16. 5.3.1
# INTERVALO DE CONFIANZA PARA LA MEDIA DEL GASTO


media <- mean(gasto)
desv <- sd(gasto)
n <- length(gasto)

error_estandar <- desv / sqrt(n)

# Valor crítico t
t_critico <- qt(
  0.975,
  df = n - 1
)

# Intervalo de confianza
li <- media - t_critico * error_estandar
ls <- media + t_critico * error_estandar

cat("\n")
cat("============================================\n")
cat("5.3.1. INTERVALO DE CONFIANZA PARA LA MEDIA\n")
cat("============================================\n")

cat(sprintf("Tamaño de muestra: %d\n", n))
cat(sprintf("Media: S/ %.2f\n", media))
cat(sprintf("Desviación estándar: S/ %.2f\n", desv))
cat(sprintf("Error estándar: S/ %.2f\n", error_estandar))
cat(sprintf("t crítico: %.3f\n", t_critico))
cat(sprintf("Límite inferior: S/ %.2f\n", li))
cat(sprintf("Límite superior: S/ %.2f\n", ls))

cat(sprintf(
  "IC 95%% = (S/ %.2f ; S/ %.2f)\n",
  li,
  ls
))



# 17. FIGURA 8
# 5.3.1. INTERVALO DE CONFIANZA PARA LA MEDIA 95%


x_ic_media <- seq(
  media - 4 * error_estandar,
  media + 4 * error_estandar,
  length.out = 500
)

y_ic_media <- dnorm(
  x_ic_media,
  mean = media,
  sd = error_estandar
)

datos_ic_media <- data.frame(
  x = x_ic_media,
  y = y_ic_media
)

grafico_ic_media <- ggplot(
  datos_ic_media,
  aes(x = x, y = y)
) +
  
  # Área del IC 95%
  geom_area(
    data = subset(
      datos_ic_media,
      x >= li & x <= ls
    ),
    fill = "lightblue",
    alpha = 0.7
  ) +
  
  # Curva normal
  geom_line(
    color = "blue",
    linewidth = 1.2
  ) +
  
  # Media muestral
  geom_vline(
    xintercept = media,
    color = "red",
    linewidth = 1
  ) +
  
  # Límite inferior
  geom_vline(
    xintercept = li,
    color = "darkgreen",
    linetype = "dashed",
    linewidth = 1
  ) +
  
  # Límite superior
  geom_vline(
    xintercept = ls,
    color = "darkgreen",
    linetype = "dashed",
    linewidth = 1
  ) +
  
  labs(
    title = "Intervalo de confianza del 95% para la media",
    subtitle = "Gasto mensual en transporte de los estudiantes",
    x = "Media muestral del gasto mensual (S/)",
    y = "Densidad"
  ) +
  
  theme_classic() +
  
  theme(
    plot.title = element_text(
      face = "bold",
      hjust = 0.5
    ),
    plot.subtitle = element_text(
      hjust = 0.5
    )
  )

print(grafico_ic_media)



