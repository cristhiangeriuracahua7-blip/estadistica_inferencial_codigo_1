# 13. FIGURA 5
# DISTRIBUCIÓN MUESTRAL DE LA MEDIA


media <- mean(gasto)
desv <- sd(gasto)
n <- length(gasto)

error_estandar <- desv / sqrt(n)

x_media <- seq(
  media - 4 * error_estandar,
  media + 4 * error_estandar,
  length.out = 500
)

