# 1. CARGA DE LIBRERÍAS Y DATOS
# ------------------------------------------------------------------------------
if (!require("readxl")) install.packages("readxl")
if (!require("moments")) install.packages("moments")

library(readxl)
library(moments)

# Cargar base de datos (asegúrate de tener el archivo en tu directorio de trabajo)
datos <- read_excel("BASE DE DATOS.xlsx")

# 2. ANÁLISIS DESCRIPTIVO Y MEDIDAS DE FORMA (Objetivo 1)
# ------------------------------------------------------------------------------
n <- length(datos$gasto)
media_gasto <- mean(datos$gasto)
mediana_gasto <- median(datos$gasto)
sd_gasto <- sd(datos$gasto)
var_gasto <- var(datos$gasto)
min_gasto <- min(datos$gasto)
max_gasto <- max(datos$gasto)
cv_gasto <- (sd_gasto / media_gasto) * 100

asimetria_gasto <- skewness(datos$gasto)
curtosis_gasto <- kurtosis(datos$gasto)

cat("--- RESUMEN DESCRIPTIVO DE LA VARIABLE GASTO MENSUAL ---\n")
cat("N:", n, "\nMedia:", round(media_gasto, 2), "\nMediana:", round(mediana_gasto, 2),
    "\nDesviación Estándar:", round(sd_gasto, 2), "\nCV (%):", round(cv_gasto, 2), "%\n")
cat("Asimetría (Fisher):", round(asimetria_gasto, 4), "\nCurtosis (g2):", round(curtosis_gasto, 4), "\n\n")

# 3. EVALUACIÓN DEL SUPUESTO DE NORMALIDAD (Shapiro-Wilk)
# ------------------------------------------------------------------------------
# H0: Los datos del gasto mensual siguen una distribución normal.
# H1: Los datos del gasto mensual NO siguen una distribución normal.
shapiro_result <- shapiro.test(datos$gasto)
print(shapiro_result)

# 4. CONTRASTE DE HIPÓTESIS PARAMÉTRICA: CORRELACIÓN DE PEARSON (Objetivo 4)
# ------------------------------------------------------------------------------
# H0: rho = 0 (No existe correlación lineal entre viajes semanales y gasto mensual)
# H1: rho > 0 (Existe correlación lineal positiva entre viajes semanales y gasto mensual)
pearson_result <- cor.test(datos$viajes, datos$gasto, alternative = "greater", method = "pearson")
print(pearson_result)

# 5. CONTRASTE DE HIPÓTESIS NO PARAMÉTRICA: CORRELACIÓN DE SPEARMAN (Objetivo 4)
# ------------------------------------------------------------------------------
# H0: rho_s = 0 (No existe asociación monótona entre la jerarquía de viajes y gasto)
# H1: rho_s > 0 (Existe asociación monótona positiva entre la jerarquía de viajes y gasto)
spearman_result <- cor.test(datos$viajes, datos$gasto, alternative = "greater", method = "spearman")
print(spearman_result)

# 6. CONTRASTE DE HOMOGENEIDAD: CHI-CUADRADA DE HOMOGENEIDAD
# ------------------------------------------------------------------------------
# H0: La proporción de gasto elevado (>= S/ 100) es homogénea según el tipo de transporte
# H1: La proporción de gasto elevado (>= S/ 100) NO es homogénea según el tipo de transporte
datos$transporte_agrupado <- ifelse(datos$tipo_transporte == "Combi", "Combi", "Colectivo/Taxi")
datos$categoria_gasto <- ifelse(datos$gasto >= 100, "Gasto >= S/100", "Gasto < S/100")

tabla_contingencia <- table(datos$transporte_agrupado, datos$categoria_gasto)
cat("--- TABLA DE CONTINGENCIA PARA HOMOGENEIDAD ---\n")
print(tabla_contingencia)

chi_homogeneidad <- chisq.test(tabla_contingencia, correct = FALSE)
print(chi_homogeneidad)

# 7. INTERVALOS DE CONFIANZA DEL 95% (Objetivo 3)
# ------------------------------------------------------------------------------
ic_media <- t.test(datos$gasto, conf.level = 0.95)$conf.int
cat("\n--- IC 95% PARA LA MEDIA POBLACIONAL ---\n")
print(ic_media)

casos_altos <- sum(datos$gasto >= 100)
ic_prop <- prop.test(x = casos_altos, n = n, conf.level = 0.95, correct = FALSE)$conf.int
cat("\n--- IC 95% PARA LA PROPORCIÓN POBLACIONAL ---\n")
print(ic_prop)
